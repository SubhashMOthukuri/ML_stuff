# NYC Airbnb Price Prediction — environment variables
# Copy to .env and fill in for local dev. docker-compose.yml sets these
# directly for the containerized stack — this file is for running the
# API outside Docker (e.g. `uvicorn src.new_york_workflow.nyc_api:app`).

# ── Redis (prediction cache + DLQ) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL_SECONDS=300

# ── SQLite stores ─────────────────────────────────────────────────────────────
PREDICTION_DB=data/predictions.db
DLQ_MAX_SIZE=10000

# ── Rate limiting (slowapi) ──────────────────────────────────────────────────
RATE_LIMIT=60/minute

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── MLflow model registry ─────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_UI_URL=http://localhost:5000

# ── OpenTelemetry tracing (optional — leave unset to disable) ────────────────
# OTLP_ENDPOINT=http://localhost:4317

# ── API key auth (optional — leave unset to disable auth for local dev) ──────────────────
# Comma-separated valid keys. Key rotation: add new key, deploy, remove old key, deploy.
# VALID_API_KEYS=key-one,key-two

# ── Ground truth ingestion (optional — leave unset to disable POST /ground-truth/ingest) ──
# Shared secret checked against the X-Ingest-Token header. Set the same value
# in this server's env AND as the GROUND_TRUTH_INGEST_TOKEN GitHub Actions
# secret on the repo (.github/workflows/ground-truth.yml calls this endpoint
# monthly via PROD_API_URL, also a GitHub Actions secret).
# GROUND_TRUTH_INGEST_TOKEN=

# ── Misc ───────────────────────────────────────────────────────────────────────
ALERTS_FILE=models/nyc/alerts.json

    {
      "id": 18,
      "title": "R\u00b2 History (per retrain)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "nyc_model_r2",
          "legendFormat": "R\u00b2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",

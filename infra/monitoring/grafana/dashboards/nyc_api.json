          "expr": "nyc_model_mae_dollar",
          "legendFormat": "MAE $"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",

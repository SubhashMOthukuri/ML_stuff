          ]
        }
      }
    },
    {
      "id": 16,
      "title": "Raw Null Price %",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "expr": "nyc_model_null_price_pct",
          "legendFormat": "null %"
